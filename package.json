{
  "name": "emoji-renderer",
  "version": "1.0.0",
  "description": "Convert emoji to SVG markup or raster images with native, Twemoji, OpenMoji, Noto, and Fluent sources.",
  "keywords": [
    "canvas",
    "emoji",
    "fluent",
    "image",
    "native",
    "noto",
    "openmoji",
    "svg",
    "twemoji"
  ],
  "homepage": "https://github.com/tamb/emoji-renderer#readme",
  "bugs": {
    "url": "https://github.com/tamb/emoji-renderer/issues"
  },
  "license": "MIT",
  "author": "Tom Saporito",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tamb/emoji-renderer.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./emojiToSvg": {
      "types": "./dist/emojiToSvg.d.mts",
      "import": "./dist/emojiToSvg.mjs"
    },
    "./emojiToImage": {
      "types": "./dist/emojiToImage.d.mts",
      "import": "./dist/emojiToImage.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "ci:simulate": "npm ci && npx vp check && npm run test:install-browsers && npm run test && npm run test:coverage && npx vp pack && npm run build-storybook",
    "test": "vp test",
    "test:unit": "vp test --project unit",
    "test:install-browsers": "node scripts/install-playwright-browsers.mts",
    "test:node": "vp test --project node",
    "test:browser": "vp test --project browser",
    "test:browser:mobile": "vp test --project browser-mobile",
    "test:coverage": "vp test --project unit --coverage",
    "check": "vp check",
    "generate:fluent-map": "node scripts/generate-fluent-map.mts",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "dependencies": {
    "@twemoji/api": "^17.0.2"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "@resvg/resvg-js": "^2.6.2",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/html-vite": "^10.5.10",
    "@types/node": "^26.1.1",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "bumpp": "^11.1.0",
    "happy-dom": "^20.11.1",
    "playwright": "^1.62.0",
    "storybook": "^10.5.10",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
    "vite-plus": "0.2.9"
  },
  "peerDependencies": {
    "@napi-rs/canvas": ">=0.1.0",
    "@resvg/resvg-js": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@napi-rs/canvas": {
      "optional": true
    },
    "@resvg/resvg-js": {
      "optional": true
    }
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=10.0.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
