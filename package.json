{
  "name": "emoji-renderer",
  "version": "0.1.0-rc.2",
  "description": "Convert emoji to SVG markup or raster images with lazy-loaded Twemoji assets.",
  "keywords": [
    "canvas",
    "emoji",
    "image",
    "svg",
    "twemoji"
  ],
  "homepage": "https://github.com/tamb/emoji-renderer#readme",
  "bugs": {
    "url": "https://github.com/tamb/emoji-renderer/issues"
  },
  "license": "MIT",
  "author": "Tom Saporito",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tamb/emoji-renderer.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./emojiToSvg": {
      "types": "./dist/emojiToSvg.d.mts",
      "import": "./dist/emojiToSvg.mjs"
    },
    "./emojiToImage": {
      "types": "./dist/emojiToImage.d.mts",
      "import": "./dist/emojiToImage.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test --project unit",
    "test:browser": "vp test --project browser",
    "test:all": "vp test",
    "test:coverage": "vp test --project unit --coverage",
    "check": "vp check",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "dependencies": {
    "@twemoji/api": "^17.0.2"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/html-vite": "^10.4.6",
    "@types/node": "^26.1.1",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "bumpp": "^11.1.0",
    "happy-dom": "^20.11.1",
    "playwright": "^1.62.0",
    "storybook": "^10.4.6",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6",
    "vite-plus": "0.2.6"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=10.0.0",
      "onFail": "download"
    }
  }
}
